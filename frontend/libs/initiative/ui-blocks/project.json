{
  "name": "initiative-ui-blocks",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "frontend/libs/initiative/ui-blocks/src",
  "prefix": "lib",
  "projectType": "library",
  "tags": [
    "type:ui-composition",
    "domain:initiative"
  ],
  "targets": {
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
